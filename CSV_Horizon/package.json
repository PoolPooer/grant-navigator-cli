{
  "name": "csv-horizon-analyzer",
  "version": "1.0.0",
  "description": "TypeScript analyzer for Horizon Europe CSV datasets to extract project insights and organization prowess",
  "main": "dist/csv-analyzer.js",
  "types": "dist/csv-analyzer.d.ts",
  "scripts": {
    "build": "tsc",
    "start": "node dist/csv-analyzer.js",
    "dev": "ts-node csv-analyzer.ts",
    "analyze": "npm run build && npm start",
    "lint": "eslint src/**/*.ts",
    "clean": "rimraf dist"
  },
  "keywords": [
    "horizon-europe",
    "csv-parser",
    "data-analysis",
    "research-grants",
    "typescript"
  ],
  "author": "Your Name",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "rimraf": "^5.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
} 